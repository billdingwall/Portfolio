---
import HomeLayout from '@layouts/HomeLayout.astro';

// We need to fetch the collections that were previously in Metalsmith
const portfolioWork = Object.values(import.meta.glob('../posts/case-study-*.md', { eager: true }));
const workExperience = Object.values(import.meta.glob('../posts/experience/*.md', { eager: true }));
const referral = Object.values(import.meta.glob('../posts/referral/*.md', { eager: true }));

// Map frontmatter to the shape expected by the layout/components
const mappedPortfolioWork = portfolioWork.map((p: any) => ({
  ...p.frontmatter,
  path: p.url || p.file.split('/').pop().replace('.md', ''),
}));

const mappedWorkExperience = await Promise.all(
  workExperience
    .filter((w: any) => w.frontmatter.collection === 'workExperience')
    .map(async (w: any) => ({ ...w.frontmatter, contents: await w.compiledContent() }))
).then(items => items.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()));

const mappedReferral = await Promise.all(
  referral.map(async (r: any) => ({ ...r.frontmatter, contents: await r.compiledContent() }))
);
---

<HomeLayout
  title="William Dingwall | Product designer | Identity Design"
  portfolioWork={mappedPortfolioWork}
  workExperience={mappedWorkExperience}
  referral={mappedReferral}
/>
