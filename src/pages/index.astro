---
import HomeLayout from '@layouts/HomeLayout.astro';

import { getCollection, render } from 'astro:content';

// Fetch the collections using Astro's content layer
const portfolioWork = await getCollection('caseStudies');
const workExperience = await getCollection('workExperience');
const referrals = await getCollection('referrals');

// Map frontmatter to the shape expected by the layout/components
const mappedPortfolioWork = portfolioWork.map((p) => ({
  ...p.data,
  path: p.id,
}));

const mappedWorkExperience = await Promise.all(
  workExperience
    .filter((w) => w.data.collection === 'workExperience')
    .map(async (w) => {
      const { html } = await render(w);
      return { ...w.data, contents: html };
    })
).then(items => items.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()));

const mappedReferral = await Promise.all(
  referrals.map(async (r) => {
    const { html } = await render(r);
    return { ...r.data, contents: html };
  })
);
---

<HomeLayout
  title="Bill Dingwall | Product designer | Identity Design"
  portfolioWork={mappedPortfolioWork}
  workExperience={mappedWorkExperience}
  referral={mappedReferral}
/>
