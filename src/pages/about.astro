---
import AboutLayout from '@layouts/AboutLayout.astro';
import { getCollection, render } from 'astro:content';

const profilePics = await getCollection('profilePics');
const galleryImages = await getCollection('gallery');
const socialMedia = await getCollection('socialMedia');

const mappedProfilePics = await Promise.all(
  profilePics.map(async (p) => {
    const { html } = await render(p);
    return { ...p.data, contents: html };
  })
);

const mappedGalleryImages = await Promise.all(
  galleryImages.map(async (g) => {
    const { html } = await render(g);
    return { ...g.data, contents: html };
  })
);

const mappedSocialMedia = await Promise.all(
  socialMedia.map(async (s) => {
    const { html } = await render(s);
    return { ...s.data, contents: html };
  })
);
---

<AboutLayout
  title="Bill Dingwall | Product designer | Identity Design"
  profilePics={mappedProfilePics}
  galleryImages={mappedGalleryImages}
  socialMedia={mappedSocialMedia}
/>
