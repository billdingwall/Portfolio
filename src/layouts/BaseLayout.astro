---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
  bodyId?: string;
  showHeader?: boolean;
}

const {
  title = "William Dingwall | Product designer | Identity Design",
  description = "I build stuff",
  ogImage,
  ogUrl,
  bodyId = "",
  showHeader = true
} = Astro.props;

import { Header } from '@components/Header';
import { Footer } from '@components/Footer';
import '@scss/main.scss';
import '@splidejs/splide/css';

// We fetch social media here globally to pass into Header
const socialMedia = await Promise.all(
  Object.values(import.meta.glob('../posts/socials/*.md', { eager: true }))
    .map(async (s: any) => ({ ...s.frontmatter, contents: await s.compiledContent() }))
);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {ogImage && <meta property="og:image" content={`https://williamdingwall.com/${ogImage}`} />}
  {description && <meta property="og:description" content={description} />}
  {ogUrl && <meta property="og:url" content={`https://williamdingwall.com/${ogUrl}`} />}
  {title && <meta property="og:title" content={title} />}

  <title>{title}</title>
  <link rel="icon" type="image/ico" href="/img/favicon.ico" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Antonio:wght@300&display=swap" rel="stylesheet">

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-KH99855ZFW"></script>

  <!-- Named slot: child layouts inject page-specific head content here -->
  <slot name="head" />
</head>
<body id={bodyId}>
  {showHeader && <Header socialMedia={socialMedia} />}

  <slot />

  <Footer />

  <!-- Vite-bundled: GA init + Splide init (replaces public/js/index.js + CDN scripts) -->
  <script>
    import Splide from '@splidejs/splide';

    // Conditionally load GA based on host
    if (window.location.hostname === 'williamdingwall.com') {
      window.dataLayer = window.dataLayer || [];
      function gtag(...args: any[]) { window.dataLayer.push(args); }
      gtag('js', new Date());
      gtag('config', 'G-KH99855ZFW');
    }

    // Initialize Splide carousels
    function initSplide() {
      const splides = document.querySelectorAll('.splide');
      splides.forEach((el) => {
        new Splide(el as HTMLElement, {
          type: 'loop',
          autoplay: true,
          interval: 10000,
        }).mount();
      });
    }

    // Run on initial load
    initSplide();

    // Re-run on client-side navigations (View Transitions)
    document.addEventListener('astro:page-load', initSplide);
  </script>
</body>
</html>
