---
import BaseLayout from './BaseLayout.astro';
import { PhotoSwipe } from '../components/PhotoSwipe';
import '../scss/photoswipe/photoswipe.scss';
import '../scss/photoswipe/default-skin.scss';

export interface Props {
  title: string;
  collection_label?: string;
  thumb?: string;
  intro?: string;
  path?: string;
  id?: string;
}

const { title, collection_label, thumb, intro, path, id } = Astro.props;
---

<BaseLayout
  title={title}
  description={intro}
  ogImage={thumb}
  ogUrl={path}
  bodyId={id}
>
  <article class="Article">
    <header class="Article-header">
      <h1>{title}</h1>
      <p>{collection_label}</p>
      {thumb && <img src={thumb} alt={title} />}
    </header>
    <slot />
  </article>

  <PhotoSwipe />

  <script is:inline src="/js/photoswipe/photoswipe.min.js"></script>
  <script is:inline src="/js/photoswipe/photoswipe-ui-default.min.js"></script>

  <script is:inline>
    (function() {
      var pswpElement = document.querySelectorAll('.pswp')[0];
      var slides = [];

      function setupSlides() {
        slides = [];
        var images = document.querySelectorAll('.Article-image img');
        images.forEach(function(img, i) {
          img.setAttribute('slideIndex', i);
          slides.push({
            src: img.getAttribute('src') || '',
            w: img.naturalWidth || 1200,
            h: img.naturalHeight || 800
          });
        });
      }

      document.addEventListener('DOMContentLoaded', function() {
        var images = document.querySelectorAll('.Article-image img');
        images.forEach(function(img) {
          img.addEventListener('click', function() {
            setupSlides();
            var indexAttr = this.getAttribute('slideIndex');
            var start = { index: indexAttr ? parseInt(indexAttr, 10) : 0 };
            if (typeof PhotoSwipe !== 'undefined' && typeof PhotoSwipeUI_Default !== 'undefined') {
              var gallery = new PhotoSwipe(pswpElement, PhotoSwipeUI_Default, slides, start);
              gallery.init();
            }
          });
        });
      });
    })();
  </script>
</BaseLayout>
