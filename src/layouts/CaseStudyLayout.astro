---
import BaseLayout from '@layouts/BaseLayout.astro';
import PhotoSwipeShell from '@components/PhotoSwipeShell.astro';
import { Image } from 'astro:assets';

export interface Props {
  title: string;
  collection_label?: string;
  thumb?: string;
  intro?: string;
  path?: string;
  id?: string;
}

const { title, collection_label, thumb, intro, path, id } = Astro.props;

// Dynamically resolve cover image from src/assets
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/**/*.{jpg,jpeg,png,gif,webp,svg}');
const coverPath = thumb ? `/src/assets${thumb}` : null;
const coverImage = coverPath && images[coverPath] ? (await images[coverPath]()).default : null;
---

<BaseLayout
  title={title}
  description={intro}
  ogImage={thumb}
  ogUrl={path}
  bodyId={id}
>
  <article class="Article">
    <header class="Article-header">
      <h1>{title}</h1>
      <p>{collection_label}</p>
      {coverImage
        ? <Image src={coverImage} alt={title} width={1200} />
        : thumb && <img src={thumb} alt={title} />
      }
    </header>
    <slot />
  </article>

  <PhotoSwipeShell />

  <!-- Vite-processed script: bundled, minified, tree-shaken -->
  <script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';
    import 'photoswipe/style.css';

    let lightbox: PhotoSwipeLightbox | null = null;

    function initPhotoSwipe() {
      // Teardown any previous instance first
      destroyPhotoSwipe();

      const articleImages = document.querySelectorAll<HTMLImageElement>('.Article-image img');
      if (!articleImages.length) return;

      // PhotoSwipe v5: use Lightbox for declarative gallery binding
      lightbox = new PhotoSwipeLightbox({
        gallery: '.Article',
        children: '.Article-image img',
        pswpModule: () => import('photoswipe'),
      });

      lightbox.init();
    }

    function destroyPhotoSwipe() {
      if (lightbox) {
        lightbox.destroy();
        lightbox = null;
      }
    }

    // Initialize on first load
    initPhotoSwipe();

    // Re-initialize on client-side page transitions (View Transitions)
    document.addEventListener('astro:page-load', initPhotoSwipe);

    // Teardown before page swap to prevent memory leaks
    document.addEventListener('astro:before-swap', destroyPhotoSwipe);
  </script>
</BaseLayout>
