{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "thumb": {
      "type": "string"
    },
    "collection": {
      "type": "string"
    },
    "collection_label": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "thumb",
    "collection",
    "date"
  ]
}